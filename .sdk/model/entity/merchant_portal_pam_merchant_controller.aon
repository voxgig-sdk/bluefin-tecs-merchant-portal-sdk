# Entity: merchant_portal_pam_merchant_controller

main: kit: entity: merchant_portal_pam_merchant_controller: {

  alias: field: {}

  fields: [
    {
      name: "additional_data"
      req: false
      short: "Optional additional merchant-specific data related to enabling acquiring."
      type: "`$OBJECT`"
    }
    {
      name: "businessRegistrationNumber"
      req: true
      type: "`$STRING`"
    }
    {
      name: "city"
      req: false
      short: "City where the merchant is located."
      type: "`$STRING`"
    }
    {
      name: "companyName"
      req: true
      type: "`$STRING`"
    }
    {
      name: "corporateUUID"
      req: true
