      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      short: "Country where the merchant is located."
      type: "`$STRING`"
    }
    {
      name: "currency"
      req: true
      short: "Transaction currency in ISO 4217 format."
      type: "`$STRING`"
    }
    {
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "language"
      req: true
      type: "`$STRING`"
    }
    {
      name: "login"
      req: true
      type: "`$STRING`"
    }
    {
      name: "mandator"
      req: true
