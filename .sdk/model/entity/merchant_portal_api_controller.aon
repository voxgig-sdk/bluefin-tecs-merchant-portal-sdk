            id: "POST /merchantportalws/deactivateTerminal"
            json: "{\"operationId\":\"deactivateTerminalUsingPOST\",\"parameters\":[{\"description\":\"Authorization\",\"in\":\"header\",\"name\":\"Authorization\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"reason_deactivation\":{\"description\":\"Reason for terminal deactivation.\",\"example\":\"Terminal was stolen\",\"type\":\"string\"},\"terminalid\":{\"description\":\"TECS terminalid given by Tecs processing engine.\",\"example\":88091105,\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"reason_deactivation\",\"terminalid\"],\"title\":\"InputDeactivateTerminal\",\"type\":\"object\"}}},\"description\":\"inputDeactivateTerminal\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"responseCode\":{\"description\":\"Response code (0 = OK, otherwise an error code).\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"responseMessage\":{\"description\":\"Human readable response code representation.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"responseCode\",\"responseMessage\"],\"title\":\"OutputDeactivateTerminal\",\"type\":\"object\"}}},\"description\":\"OK\"}},\"securitySource\":\"unspecified\"}"
