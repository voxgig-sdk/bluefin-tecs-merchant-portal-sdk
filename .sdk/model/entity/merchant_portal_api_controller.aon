          }
          contract: {
            id: "POST /merchantportalws/registerAdditionalTerminal"
            json: "{\"operationId\":\"registerAdditionalTerminalUsingPOST\",\"parameters\":[{\"description\":\"Authorization header containing a valid Bearer token or Basic authentication credentials. Example: \\\"Bearer AT-2359-DFYpOWfDFSls4DeKDmGOXDyynx0a8Trwk\\\"\\n\",\"in\":\"header\",\"name\":\"Authorization\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"additional_data\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Arbitrary merchant-specific data related to terminal registration.\\nProvide any additional key-value pairs as required.\\n\",\"example\":{\"firstname\":\"John\",\"surname\":\"Doe\",\"type\":\"tx-300\",\"version\":\"v1.2.3\"},\"type\":\"object\"},\"packageorderuuid\":{\"description\":\"Identifier of the registered merchant in the TECS system, provided in the response of the registerNewMerchant call.\\n\",\"example\":\"dccb9a6a-b02c-46e3-aef3-a28f0b7bf993\",\"type\":\"string\"},\"password\":{\"description\":\"Merchant password for MPOS. If not provided, TECS will generate a password and return it in the response.\\n\",\"example\":\"testpassword\",\"type\":\"string\"},\"productid\":{\"description\":\"Identifier of the product for which terminal registration is to be performed. If omitted, a default product may be used.\\n\",\"example\":\"d8af7e4f-a04f-42ea-91ac-bed20c5eebfe\",\"type\":\"string\"},\"terminal_country_code\":{\"description\":\"Terminal country code (must be in 'ISO-3166 ALPHA-3' format).\",\"example\":\"SVK\",\"maxLength\":3,\"minLength\":3,\"type\":\"string\"},\"terminal_language_code\":{\"description\":\"Terminal language code (must be in 'ISO 639-1' format).\",\"example\":\"EN\",\"maxLength\":2,\"minLength\":2,\"type\":\"string\"},\"terminal_location\":{\"description\":\"Physical or logical location of the terminal.\",\"example\":\"Palisady 12 BA\",\"type\":\"string\"},\"terminal_serial_number\":{\"description\":\"Terminal serial number.\",\"example\":\"325-320-924\",\"type\":\"string\"},\"terminalid_acquirer\":{\"description\":\"Terminal ID as set by the acquirer (optional).\",\"example\":\"66000001\",\"type\":\"string\"},\"user_email\":{\"description\":\"Email address of the user acting on behalf of the merchant.\",\"example\":\"testemail@tecs.at\",\"format\":\"email\",\"type\":\"string\"},\"user_phone_number\":{\"description\":\"Phone number of the user acting on behalf of the merchant. Must be in international format (e.g., +421910711234).\\n\",\"example\":\"+421910876567\",\"type\":\"string\"},\"username\":{\"description\":\"Merchant username for MPOS. If not provided, TECS will generate a username and include it in the response.\\n\",\"example\":\"testuser\",\"type\":\"string\"},\"web_shop_url\":{\"description\":\"URL of the merchant's web shop.\",\"example\":\"https://www.tecs.at\",\"format\":\"uri\",\"type\":\"string\"}},\"required\":[\"packageorderuuid\",\"terminal_country_code\",\"terminal_language_code\",\"terminal_location\",\"terminal_serial_number\"],\"title\":\"InputRegisterAdditionalTerminal\",\"type\":\"object\"}}},\"description\":\"JSON payload containing the details required to register an additional terminal. This includes the package order UUID and terminal-specific details.\\n\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"password\":{\"description\":\"TECS generated merchant password in case if not provided in request.\",\"example\":\"testpassword\",\"type\":\"string\"},\"responseCode\":{\"description\":\"Response code (0 = OK, otherwise an error code).\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"responseMessage\":{\"description\":\"Human readable response code representation.\",\"example\":\"OK\",\"type\":\"string\"},\"terminalid\":{\"description\":\"TECS terminalid given by TECS processing engine.\",\"example\":88091104,\"format\":\"int32\",\"type\":\"integer\"},\"username\":{\"description\":\"TECS generated merchant username in case if not provided in request.\",\"example\":\"testuser\",\"type\":\"string\"}},\"required\":[\"responseCode\",\"responseMessage\"],\"title\":\"OutputRegisterAdditionalTerminal\",\"type\":\"object\"}}},\"description\":\"Successful registration of an additional terminal.\"},\"400\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Bad Request – One or more required fields are missing or incorrectly formatted.\"},\"401\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Unauthorized – Invalid authentication credentials provided.\"},\"403\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Forbidden – The caller does not have permission to register an additional terminal.\"},\"500\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Internal Server Error – An unexpected error occurred on the server.\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
