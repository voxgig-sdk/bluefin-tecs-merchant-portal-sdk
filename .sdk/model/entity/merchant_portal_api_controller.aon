          contract: {
            id: "POST /merchantportalws/registerNewMerchant"
            json: "{\"operationId\":\"registerNewMerchantUsingPOST\",\"parameters\":[{\"description\":\"Authorization credentials (Bearer token or Basic authentication).  Example: \\\"Bearer AT-2359-DFYpOWfDFSls4DeKDmGOXDyynx0a8Trwk\\\"\\n\",\"in\":\"header\",\"name\":\"Authorization\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"account_number\":{\"description\":\"Account number provided by the acquirer.\",\"example\":123456,\"format\":\"int32\",\"type\":\"integer\"},\"additional_data\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Arbitrary merchant-specific data related to enabling acquiring or terminal registration.\\nThis object can contain key-value pairs where the value is a string.\\n\",\"example\":{\"firstname\":\"John\",\"surname\":\"Doe\",\"type\":\"tx-300\",\"version\":\"v1.2.3\"},\"type\":\"object\"},\"business_reg_number\":{\"description\":\"Merchant business registration number as stated in the company registry. Typically a 9-character alphanumeric string.\",\"example\":\"345345345\",\"type\":\"string\"},\"city\":{\"description\":\"Merchant's address: city.\",\"example\":\"Bratislava\",\"type\":\"string\"},\"corporateuuid\":{\"description\":\"Unique identifier for the corporate entity (UUID format).\",\"example\":\"123e4567-e89b-12d3-a456-426614174000\",\"type\":\"string\"},\"country\":{\"description\":\"Merchant's address: country (must be in 'ISO-3166 ALPHA-3' format).\",\"example\":\"SVK\",\"maxLength\":3,\"minLength\":3,\"type\":\"string\"},\"currency\":{\"description\":\"Transaction currency (must be in \\\"ISO 4217\\\" format).\",\"example\":\"EUR\",\"maxLength\":3,\"minLength\":3,\"type\":\"string\"},\"merchant_category_code\":{\"description\":\"Merchant category code as defined by the payment network.\",\"example\":5999,\"format\":\"int32\",\"type\":\"integer\"},\"merchant_email\":{\"description\":\"Merchant's email address for receiving notifications.\",\"example\":\"testemail@tecs.at\",\"format\":\"email\",\"type\":\"string\"},\"merchant_name\":{\"description\":\"The officially incorporated company name of the merchant.\",\"example\":\"Test merchant\",\"type\":\"string\"},\"merchant_phone_number\":{\"description\":\"Merchant's phone number for notifications. Must be in international format (e.g., +421910711234).\",\"example\":\"+421910876567\",\"type\":\"string\"},\"packageid\":{\"description\":\"Identifier of the package in the TECS processing engine provided by TECS. Typically a UUID.\",\"example\":\"87055654-3158-42fc-9838-74f1fc77f42b\",\"type\":\"string\"},\"password\":{\"description\":\"Merchant password for MPOS. If not provided, TECS will generate a password and return it in the response.\\n\",\"example\":\"testpassword\",\"type\":\"string\"},\"productid\":{\"description\":\"Identifier of the product for which terminal registration is being performed.\",\"example\":\"d8af7e4f-a04f-42ea-91ac-bed20c5eebfe\",\"type\":\"string\"},\"productid_acquirer\":{\"description\":\"Identifier of the product for which acquiring is enabled.\",\"example\":\"874d84a8-a6f4-47fa-b594-944593fc394b\",\"type\":\"string\"},\"sorting_code\":{\"description\":\"Sorting code provided by the acquirer.\",\"example\":123456,\"format\":\"int32\",\"type\":\"integer\"},\"state\":{\"description\":\"Merchant's address: state. May be null if not applicable.\",\"example\":\"null\",\"type\":\"string\"},\"street\":{\"description\":\"Merchant's address: street and house number.\",\"example\":\"Palisady 12\",\"type\":\"string\"},\"terminal_country_code\":{\"description\":\"Terminal country code (must be in \\\"ISO-3166 ALPHA-3\\\" format).\",\"example\":\"SVK\",\"maxLength\":3,\"minLength\":3,\"type\":\"string\"},\"terminal_language_code\":{\"description\":\"Terminal language code (must be in \\\"ISO 639-1\\\" format).\",\"example\":\"EN\",\"maxLength\":2,\"minLength\":2,\"type\":\"string\"},\"terminal_location\":{\"description\":\"Physical or logical location of the terminal.\",\"example\":\"Palisady 12 BA\",\"type\":\"string\"},\"terminal_serial_number\":{\"description\":\"Terminal serial number.\",\"example\":\"325-320-924\",\"type\":\"string\"},\"terminalid_acquirer\":{\"description\":\"Terminal ID as provided by the acquirer (if applicable).\",\"example\":\"66000001\",\"type\":\"string\"},\"user_email\":{\"description\":\"Email address of the user acting on behalf of the merchant.\",\"example\":\"testemail12@tecs.at\",\"format\":\"email\",\"type\":\"string\"},\"user_phone_number\":{\"description\":\"Phone number of the user acting on behalf of the merchant. Must be in international format (e.g., +421910711234).\",\"example\":\"+421910876568\",\"type\":\"string\"},\"username\":{\"description\":\"Merchant username for MPOS. If not provided, TECS will generate a username and include it in the response.\\n\",\"example\":\"testuser\",\"type\":\"string\"},\"vu_nummer\":{\"description\":\"Merchant contract number with the acquirer.\",\"example\":\"9034520\",\"type\":\"string\"},\"web_shop_url\":{\"description\":\"URL of the merchant's web shop.\",\"example\":\"https://www.tecs.at\",\"format\":\"uri\",\"type\":\"string\"},\"zipcode\":{\"description\":\"Merchant's address: postal code.\",\"example\":\"81106\",\"type\":\"string\"}},\"required\":[\"business_reg_number\",\"city\",\"country\",\"currency\",\"merchant_category_code\",\"merchant_name\",\"packageid\",\"street\",\"terminal_country_code\",\"terminal_language_code\",\"terminal_location\",\"terminal_serial_number\",\"vu_nummer\",\"zipcode\"],\"title\":\"InputRegisterNewMerchant\",\"type\":\"object\"}}},\"description\":\"JSON payload containing all required fields for merchant and terminal registration.\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"corporateuuid\":{\"description\":\"An UUID of the newly registered corporate (if created during the flow - it is an optional value).\",\"example\":\"fd1b6927-9105-4e2a-92c0-07c6da71624d\",\"type\":\"string\"},\"packageorderuuid\":{\"description\":\"Unique identifier, which could be used later for registering additional terminals for existing merchants.\",\"example\":\"16acb5a4-e573-423c-a024-fae90ea45d70\",\"type\":\"string\"},\"password\":{\"description\":\"TECS generated merchant password in case if not provided in request.\",\"example\":\"testpassword\",\"type\":\"string\"},\"responseCode\":{\"description\":\"Response code (0 = OK, otherwise an error code).\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"responseMessage\":{\"description\":\"Human readable response code representation.\",\"example\":\"OK\",\"type\":\"string\"},\"terminalid\":{\"description\":\"TECS terminalid given by TECS processing engine.\",\"example\":88091104,\"format\":\"int32\",\"type\":\"integer\"},\"username\":{\"description\":\"TECS generated merchant username in case if not provided in request.\",\"example\":\"testuser\",\"type\":\"string\"}},\"required\":[\"responseCode\",\"responseMessage\"],\"title\":\"OutputRegisterNewMerchant\",\"type\":\"object\"}}},\"description\":\"Successful merchant and terminal registration.\"},\"400\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Bad Request - One or more required fields are missing or in an incorrect format.\"},\"401\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Unauthorized - Invalid credentials provided.\"},\"403\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Forbidden - The caller does not have the necessary permissions to perform this operation.\"},\"500\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"response_code\":{\"description\":\"Response code: 0 indicates success, any non-zero value indicates an error.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"response_message\":{\"description\":\"A human-readable error message.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"response_code\",\"response_message\"],\"type\":\"object\"}}},\"description\":\"Internal Server Error - An unexpected error occurred on the server.\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/merchantportalws/registerNewMerchant"
          segments: [
            {
              lit: "merchantportalws"
            }
            {
              lit: "registerNewMerchant"
            }
