            id: "POST /merchantportalws/reactivateTerminal"
            json: "{\"operationId\":\"reactivateTerminalUsingPOST\",\"parameters\":[{\"description\":\"Authorization\",\"in\":\"header\",\"name\":\"Authorization\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"reason_reactivation\":{\"description\":\"Reason for terminal reactivation.\",\"example\":\"Terminal is again in use\",\"type\":\"string\"},\"terminalid\":{\"description\":\"TECS terminalid given by Tecs processing engine.\",\"example\":88091105,\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"reason_reactivation\",\"terminalid\"],\"title\":\"InputReactivateTerminal\",\"type\":\"object\"}}},\"description\":\"inputReactivateTerminal\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"responseCode\":{\"description\":\"Response code (0 = OK, otherwise an error code).\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"responseMessage\":{\"description\":\"Human readable response code representation.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"responseCode\",\"responseMessage\"],\"title\":\"OutputReactivateTerminal\",\"type\":\"object\"}}},\"description\":\"OK\"}},\"securitySource\":\"unspecified\"}"
