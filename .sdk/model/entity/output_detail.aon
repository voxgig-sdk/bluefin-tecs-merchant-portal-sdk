          contract: {
            id: "GET /merchantportalws/batch/registerAdditionalTerminal/details/{id}"
            json: "{\"operationId\":\"detailsUsingGET\",\"parameters\":[{\"description\":\"Authorization\",\"in\":\"header\",\"name\":\"Authorization\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"id\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"details\":{\"properties\":{\"batch\":{\"properties\":{\"id\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"},\"status\":{\"enum\":[\"COMPLETED_SUCCESSFULLY\",\"COMPLETED_WITH_ERRORS\",\"RUNNING\",\"STOPPED\"],\"type\":\"string\"},\"timestamp\":{\"type\":\"string\"}},\"title\":\"Batch\",\"type\":\"object\"},\"lines\":{\"additionalProperties\":{\"properties\":{\"data\":{\"properties\":{\"value\":{\"type\":\"string\"}},\"title\":\"Data\",\"type\":\"object\"},\"flow\":{\"properties\":{\"input\":{\"properties\":{\"additional_data\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Arbitrary merchant specific data related to register terminal steps.\",\"example\":{\"firstname\":\"John\",\"surname\":\"Doe\",\"type\":\"tx-300\",\"version\":\"v1.2.3\"},\"type\":\"object\"},\"currency\":{\"description\":\"Transaction currency (Has to be in \\\"ISO 4217\\\" format).\",\"example\":\"EUR\",\"type\":\"string\"},\"packageorderuuid\":{\"description\":\"Identifier of registered merchant in TECS system, provided by TECS in \\\"Merchant and terminal registration\\\" call.\",\"example\":\"dccb9a6a-b02c-46e3-aef3-a28f0b7bf993\",\"type\":\"string\"},\"password\":{\"description\":\"Merchant password for MPOS (In case if not provided, will be generated by TECS and provided in response parameters of the call).\",\"example\":\"testpassword\",\"type\":\"string\"},\"productid\":{\"description\":\"Identifier of the product for which terminal registration has to be performed.\",\"example\":\"d8af7e4f-a04f-42ea-91ac-bed20c5eebfe\",\"type\":\"string\"},\"terminal_country_code\":{\"description\":\"Terminal country code (Has to be in \\\"ISO-3166 ALPHA-3\\\" format).\",\"example\":\"SVK\",\"type\":\"string\"},\"terminal_language_code\":{\"description\":\"Terminal language code (Has to be in \\\"ISO 639-1\\\" format).\",\"example\":\"EN\",\"type\":\"string\"},\"terminal_location\":{\"description\":\"Terminal location.\",\"example\":\"Palisady 12 BA\",\"type\":\"string\"},\"terminal_serial_number\":{\"description\":\"Terminal serial number.\",\"example\":\"325-320-924\",\"type\":\"string\"},\"terminalid_acquirer\":{\"description\":\"A terminal ID set by acquirer\",\"example\":66000001,\"type\":\"string\"},\"user_email\":{\"description\":\"Email address of user, which acts in behalf of the merchant.\",\"example\":\"testemail@tecs.at\",\"type\":\"string\"},\"user_phone_number\":{\"description\":\"Phone number of user, which acts in behalf of the merchant (Has to be in international format: + country code + phone number. Example: +421910711234).\",\"example\":\"+421910876567\",\"type\":\"string\"},\"username\":{\"description\":\"Merchant username for MPOS (In case if not provided, will be generated by TECS and provided in response parameters of the call).\",\"example\":\"testuser\",\"type\":\"string\"}},\"required\":[\"currency\",\"packageorderuuid\",\"terminal_country_code\",\"terminal_language_code\",\"terminal_location\",\"terminal_serial_number\"],\"title\":\"FlowInput\",\"type\":\"object\"},\"output\":{\"properties\":{\"password\":{\"description\":\"TECS generated merchant password in case if not provided in request.\",\"example\":\"testpassword\",\"type\":\"string\"},\"responseCode\":{\"description\":\"Response code (0 = OK, otherwise an error code).\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"responseMessage\":{\"description\":\"Human readable response code representation.\",\"example\":\"OK\",\"type\":\"string\"},\"terminalid\":{\"description\":\"TECS terminalid given by TECS processing engine.\",\"example\":88091104,\"format\":\"int32\",\"type\":\"integer\"},\"username\":{\"description\":\"TECS generated merchant username in case if not provided in request.\",\"example\":\"testuser\",\"type\":\"string\"}},\"required\":[\"responseCode\",\"responseMessage\"],\"title\":\"FlowOutput\",\"type\":\"object\"}},\"title\":\"Flow\",\"type\":\"object\"}},\"title\":\"Line\",\"type\":\"object\"},\"type\":\"object\"},\"progress\":{\"properties\":{\"line\":{\"type\":\"string\"},\"percentage\":{\"format\":\"int32\",\"type\":\"integer\"}},\"title\":\"Progress\",\"type\":\"object\"}},\"title\":\"Details\",\"type\":\"object\"},\"responseCode\":{\"description\":\"Response code. For success state 0. For failure state lower than 0.\",\"example\":0,\"format\":\"int32\",\"type\":\"integer\"},\"responseMessage\":{\"description\":\"Response message. For success state OK. For failure state description of the cause.\",\"example\":\"OK\",\"type\":\"string\"}},\"required\":[\"responseCode\",\"responseMessage\"],\"title\":\"OutputDetails\",\"type\":\"object\"}}},\"description\":\"OK\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/merchantportalws/batch/registerAdditionalTerminal/details/{id}"
