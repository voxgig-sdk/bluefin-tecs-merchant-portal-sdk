                    "type": "string"
                  },
                  "street": {
                    "description": "Merchant's address: street and house number.",
                    "example": "Palisady 12",
                    "type": "string"
                  },
                  "terminal_country_code": {
                    "description": "Terminal country code (must be in \"ISO-3166 ALPHA-3\" format).",
