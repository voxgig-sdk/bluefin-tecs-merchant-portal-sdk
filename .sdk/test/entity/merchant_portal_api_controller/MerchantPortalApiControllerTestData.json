                    "type": "integer"
                  },
                  "merchant_email": {
                    "description": "Merchant's email address for receiving notifications.",
                    "example": "testemail@tecs.at",
                    "format": "email",
                    "type": "string"
                  },
                  "merchant_name": {
                    "description": "The officially incorporated company name of the merchant.",
                    "example": "Test merchant",
                    "type": "string"
                  },
                  "merchant_phone_number": {
                    "description": "Merchant's phone number for notifications. Must be in international format (e.g., +421910711234).",
                    "example": "+421910876567",
                    "type": "string"
                  },
                  "packageid": {
                    "description": "Identifier of the package in the TECS processing engine provided by TECS. Typically a UUID.",
