                    "type": "string"
                  },
                  "city": {
                    "description": "Merchant's address: city.",
                    "example": "Bratislava",
                    "type": "string"
                  },
                  "corporateuuid": {
                    "description": "Unique identifier for the corporate entity (UUID format).",
